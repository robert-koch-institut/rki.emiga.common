@startuml
skinparam linetype ortho

title AttachmentDocumentReference (Profile of DocumentReference) 

skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeFontName Monospaced

hide circle

class AttachmentDocumentReference{
-- Meta --
<b>+</b> meta.profile:emigaprofile: canonical(StructureDefinition) [1..1]
<b>+</b> meta.security:responsibility: Coding [1..1]
<b>+</b> meta.security:visibility: Coding [1..1]
<b>+</b> meta.tag:personalInformation: Coding [1..*]
-- Identifiers --
<b>+</b> identifier:EmigaFileNumber: IdentifierEmigaFileNumber [0..1]
<b>+</b> identifier:EmigaID: IdentifierEmigaID [0..1]
<b>+</b> identifier:SurvNetFileNumber: IdentifierSurvNetFileNumber [0..1]
-- General Information --
<b>+</b> status: FixedValue ('current') [1..1]
<b>+</b> date: instant [0..1]
<b>+</b> author: Reference(EmigaUserPractitioner) [0..1]
-- Content --
<b>+</b> content: BackboneElement [1..*]
<b>+</b> content.attachment: Attachment [0..*]
<b>+</b> content.attachment.contentType: code [1..1]
<b>+</b> content.attachment.url: url [0..1]
<b>+</b> content.attachment.size: unsignedInt [1..1]
<b>+</b> content.attachment.hash: base64Binary [1..1]
<b>+</b> content.attachment.title: string [1..1]
<b>+</b> content.attachment.creation: dateTime [1..1]
}

@enduml
