@startuml

title Dieselbe physische Person als betroffene Person und als Bezugsperson

skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam ArrowColor black
skinparam classBorderColor black
skinparam classFontColor black

hide circle

' ------------------------------------------------------------
' Person A
' ------------------------------------------------------------

class "AffectedPerson\n(Person A)" as PersonA {
  <b>Rolle:</b> betroffene Person
}

' ------------------------------------------------------------
' Person B als betroffene Person
' ------------------------------------------------------------

class "AffectedPerson\n(Person B)" as PersonB {
  <b>Rolle:</b> betroffene Person
  --
  link[relatedPersonLink]
}

' ------------------------------------------------------------
' Dieselbe Person B als Bezugsperson von Person A
' ------------------------------------------------------------

class "AffectedPersonRelatedPerson\n(Person A)" as RelatedPersonB {
  <b>Rolle:</b> Bezugsperson von Person B
  --
  patient
  relationship
}

' ------------------------------------------------------------
' Fachliche Beziehung zwischen zwei physischen Personen
' ------------------------------------------------------------

RelatedPersonB --> PersonA : patient\n«Bezugsperson gehört zu»

' ------------------------------------------------------------
' Identitätsverknüpfung derselben physischen Person
' ------------------------------------------------------------

PersonB --> RelatedPersonB : link[relatedPersonLink]

@enduml