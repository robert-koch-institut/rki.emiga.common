@startuml
skinparam linetype ortho

title AnnotationCommunication 

skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeFontName Monospaced

hide circle

class AnnotationCommunication{
-- Meta --
<b>+</b> meta.profile:emigaprofile: canonical(StructureDefinition) [1..1]
<b>+</b> meta.security:responsibility: Coding [1..1]
<b>+</b> meta.security:visibility: Coding [1..1]
<b>+</b> meta.tag:personalInformation: Coding [1..*]
-- Identifiers --
<b>+</b> identifier:EmigaFileNumber: IdentifierEmigaFileNumber [0..1]
<b>+</b> identifier:EmigaID: IdentifierEmigaID [0..1]
<b>+</b> identifier:SurvNetFileNumber: IdentifierSurvNetFileNumber [0..1]
-- Communication Content --
<b>+</b> about: Reference(Resource) [1..1] 
<b>+</b> extension:processingStatus: Coding [1..1]
<b>+</b> extension:dateCreated: instant [0..1]
<b>+</b> payload: BackboneElement [0..*]
<b>+</b> payload.content[x]:contentReference: Reference(AttachmentDocumentReference) [0..1]
<b>+</b> payload.content[x]:contentString: string [0..1]
<b>+</b> sender: Reference(EmigaUserPractitioner) [1..1] 
<b>+</b> sent: dateTime [0..1]
<b>+</b> status: FixedValue ('completed') [1..1]
<b>+</b> topic.text: string [1..1] 
}

@enduml