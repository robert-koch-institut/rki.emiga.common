using scope

from CapabilityStatement

for rest.resource

where
    supportedProfile
        .where(
            $this = %canonical
        )
        .exists()

for interaction

select
    'Name': %resource.name,
    'Interaktion': code,
    'Verbindlichkeit':
        extension
            .where(
                url = 'http://hl7.org/fhir/StructureDefinition/capabilitystatement-expectation'
            )
            .value,
    'Dokumentation' [markdown]: documentation

with
    header